+/* Whole-directory save transactions: callbacks mutate a private candidate.
+ * No dependency on achievements or any particular game's save format.
+ * Author: matymeatboy. */
+#ifdef TJ_SAVEDATA_TRANSACTION
+extern int tj_savedata_transaction_begin(const char*, int);
+extern int tj_savedata_transaction_route(char*, size_t);
+extern int tj_savedata_transaction_finish(int);
+extern int tj_savedata_transaction_delete(const char*);
+extern int tj_savedata_transaction_recover_root(const char*);
+#define TJ_DELETE_SLOT(path) tj_savedata_transaction_delete(path)
+#define TJ_ATOMIC_BEGIN(dir,save) do { \
+    char tj_original[1024]; \
+    if (!build_save_path(tj_original,sizeof(tj_original),(dir)) || \
+        !tj_savedata_transaction_begin(tj_original,(save))) { \
+        __atomic_sub_fetch(&s_savedata_busy,1,__ATOMIC_SEQ_CST); \
+        return CELL_SAVEDATA_ERROR_ACCESS_ERROR; \
+    } \
+} while(0)
+#define TJ_ATOMIC_FINISH(result) do { \
+    if (!tj_savedata_transaction_finish((result)==CELL_OK)) \
+        (result)=CELL_SAVEDATA_ERROR_ACCESS_ERROR; \
+} while(0)
+#else
+#define TJ_DELETE_SLOT(path) savedata_remove_tree(path)
+#define TJ_ATOMIC_BEGIN(dir,save) ((void)0)
+#define TJ_ATOMIC_FINISH(result) ((void)0)
+#endif
 
